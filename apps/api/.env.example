PORT=4000
NODE_ENV=development

# MongoDB — local dev uses Docker Compose; production uses Atlas (Bahrain ME-South-1)
MONGODB_URI=mongodb://localhost:27017/travanora

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use a DIFFERENT random value for each secret.
JWT_ACCESS_SECRET=replace_me_with_64_random_hex_chars
JWT_REFRESH_SECRET=replace_me_with_different_64_random_hex_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_REMEMBER_ME=30d

# Duffel — get your test token from https://app.duffel.com/developers
DUFFEL_ACCESS_TOKEN=duffel_test_xxxxx
DUFFEL_LIVE=false

# App URL — frontend base URL (used in email links)
APP_URL=http://localhost:5173

# CORS + Cookies — local dev
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5173

# CORS + Cookies — production (uncomment and set on api.travanora.com)
# COOKIE_DOMAIN=.travanora.com
# CORS_ORIGIN=https://app.travanora.com,https://travanora.com

# Stripe — get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Webhook secret — from: stripe listen --forward-to localhost:4000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# AWS / SES — IAM user needs ses:SendEmail permission on SES_FROM_EMAIL identity
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
SES_FROM_EMAIL=support@corporateregistryservices.ca
SES_REPLY_TO=support@corporateregistryservices.ca
