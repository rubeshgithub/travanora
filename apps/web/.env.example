# Local dev — React app talks to the local API server
VITE_API_URL=http://localhost:4000

# Production — set this in Vercel / Amplify / Cloudflare env vars for app.travanora.com
# VITE_API_URL=https://api.travanora.com

# Stripe publishable key (safe to expose in browser) — matches STRIPE_PUBLISHABLE_KEY in API
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
